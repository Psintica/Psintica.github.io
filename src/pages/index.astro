---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const initiatives = await getCollection('initiatives');
// Sort by order or just display active first
const featuredInitiatives = initiatives
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99))
  .slice(0, 3);
---

<BaseLayout title="Psintica | AIxScience Research Lab" activePage="Home">
  <!-- Hero Section -->
  <section class="hero-section section-padding animate-fade-in" style="position: relative; overflow: hidden; padding-bottom: 6rem;">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="badge" style="margin-bottom: 1.5rem;">AI x Science</div>
        <h1 style="margin-bottom: 1.5rem;">
          Accelerating <span style="background: linear-gradient(90deg, var(--color-primary), var(--color-secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Scientific Discovery</span>
        </h1>
        <p style="font-size: 1.25rem; color: var(--color-text-secondary); margin-bottom: 2.5rem; max-width: 620px;">
          Psintica is a neo-research lab dedicated to solving the core bottle-necks of science using Artificial Intelligence, while paving the way for undergraduates to launch active research careers.
        </p>
        <div class="hero-btns" style="display: flex; gap: 1.25rem; flex-wrap: wrap;">
          <a href="/initiatives/" class="btn btn-primary">Explore Initiatives</a>
          <a href="/join/" class="btn btn-secondary">Join Undergrad Lab</a>
        </div>
      </div>
      
      <!-- Visual Element -->
      <div class="hero-visual">
        <div class="glow-sphere-1"></div>
        <div class="glow-sphere-2"></div>
        <img src="/images/illustrations/undraw_world_re_768g.svg" alt="Illustration" class="hero-ill" />
      </div>
    </div>
  </section>

  <!-- Core Pillars -->
  <section class="pillars-section section-padding" style="background: rgba(10, 15, 30, 0.4); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div style="text-align: center; max-width: 700px; margin: 0 auto 4rem;">
        <div class="badge" style="margin-bottom: 1rem;">Core Mission</div>
        <h2>What We Do</h2>
        <p style="color: var(--color-text-muted); margin-top: 1rem; font-size: 1.1rem;">
          We operate at the convergence of machine learning and fundamental sciences, building open research pipelines and mentoring the next generation of researchers.
        </p>
      </div>

      <div class="pillars-grid">
        <div class="glass-card">
          <div class="pillar-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <h3>AI x Science</h3>
          <p style="color: var(--color-text-secondary); margin-top: 1rem;">
            We aim to solve the fundamental problem of scientific discovery: how to efficiently generate, test, and iterate on hypotheses. 
          </p>
        </div>

        <div class="glass-card">
          <div class="pillar-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h3>Undergrad Acceleration</h3>
          <p style="color: var(--color-text-secondary); margin-top: 1rem;">
            Active research shouldn't be gated behind graduate school. We bring undergrads into core lab projects and mentor them from day one.
          </p>
        </div>

        <div class="glass-card">
          <div class="pillar-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
          </div>
          <h3>Open Science</h3>
          <p style="color: var(--color-text-secondary); margin-top: 1rem;">
            We believe in open source, open data, and open science. All our tools, preprints, and datasets are fully public and accessible.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Initiatives -->
  <section class="initiatives-section section-padding">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
          <div class="badge badge-secondary" style="margin-bottom: 1rem;">Research Tracks</div>
          <h2>Featured Initiatives</h2>
        </div>
        <a href="/initiatives/" class="btn btn-secondary" style="font-size: 0.9rem;">View All Initiatives</a>
      </div>

      <div class="initiatives-grid">
        {featuredInitiatives.map(project => (
          <div class="glass-card project-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
              <span class={`badge ${project.data.status === 'active' ? '' : 'badge-secondary'}`}>
                {project.data.status}
              </span>
              <div class="project-tags" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                {project.data.tags.slice(0, 2).map(tag => (
                  <span style="font-size: 0.75rem; color: var(--color-text-muted); border: 1px solid var(--color-border); padding: 0.15rem 0.5rem; border-radius: 4px;">{tag}</span>
                ))}
              </div>
            </div>
            <h3>{project.data.title}</h3>
            <p style="color: var(--color-text-secondary); margin: 1rem 0 2rem; font-size: 0.95rem; line-height: 1.5;">
              {project.data.description}
            </p>
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border); padding-top: 1.25rem; margin-top: auto;">
              <span style="font-size: 0.85rem; color: var(--color-text-muted);">
                Lead: <strong>{project.data.leader}</strong>
              </span>
              <a href={`/initiatives/${project.id}/`} class="project-link" style="font-size: 0.9rem; font-weight: 500; display: flex; align-items: center; gap: 0.25rem;">
                Read More 
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" x2="19" y1="12" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Discord & Community Callout -->
  <section class="community-section section-padding" style="position: relative; overflow: hidden; background: radial-gradient(circle at 100% 100%, rgba(157, 78, 221, 0.12) 0%, transparent 60%);">
    <div class="container">
      <div class="glass-card" style="padding: clamp(2.5rem, 5vw, 4rem); text-align: center; max-width: 900px; margin: 0 auto; background: linear-gradient(135deg, rgba(13, 20, 38, 0.7) 0%, rgba(22, 32, 60, 0.7) 100%);">
        <h2 style="margin-bottom: 1.5rem;">Join Our Global Community</h2>
        <p style="color: var(--color-text-secondary); font-size: 1.15rem; max-width: 650px; margin: 0 auto 2.5rem;">
          Connect with undergraduate researchers, mentors, and science enthusiasts. We host weekly paper discussions, share project progress, and coordinate research cohorts on Discord.
        </p>
        <a href="https://discord.com/invite/Kjg3QYPTHj/" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.05rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><circle cx="12" cy="12" r="10"></circle><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-3.5.75.187 1.5 1 2 2.5 1.072 3.214-1.224 4.054 1 3.5.5-.125 1.5-1 1-2.5-.357-1.071-1-1.5-1.5-2"></path></svg>
          Join our Discord!
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Styles */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-ill {
    width: 100%;
    max-width: 420px;
    height: auto;
    z-index: 2;
    filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.4));
  }

  .glow-sphere-1 {
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.15) 0%, transparent 70%);
    top: -50px;
    left: -50px;
    z-index: 1;
    pointer-events: none;
  }

  .glow-sphere-2 {
    position: absolute;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(157, 78, 221, 0.15) 0%, transparent 70%);
    bottom: -80px;
    right: -50px;
    z-index: 1;
    pointer-events: none;
  }

  @media (max-width: 991px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
    }
    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .hero-btns {
      justify-content: center;
    }
    .hero-visual {
      order: -1;
    }
    .hero-ill {
      max-width: 300px;
    }
  }

  /* Pillars Styles */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .pillar-icon {
    width: 60px;
    height: 60px;
    border-radius: var(--border-radius-sm);
    background: rgba(0, 242, 254, 0.06);
    border: 1px solid rgba(0, 242, 254, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    box-shadow: var(--glow-primary);
  }

  .glass-card:nth-child(2) .pillar-icon {
    background: rgba(157, 78, 221, 0.06);
    border-color: rgba(157, 78, 221, 0.15);
    color: var(--color-secondary);
    box-shadow: var(--glow-secondary);
  }

  .glass-card:nth-child(3) .pillar-icon {
    background: rgba(255, 0, 128, 0.04);
    border-color: rgba(255, 0, 128, 0.12);
    color: var(--color-accent);
    box-shadow: 0 0 15px rgba(255, 0, 128, 0.15);
  }

  @media (max-width: 868px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Initiatives Grid */
  .initiatives-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 2rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-link {
    transition: var(--transition-snappy);
  }

  .project-card:hover .project-link {
    color: var(--color-text-primary);
    transform: translateX(4px);
  }

  @media (max-width: 480px) {
    .initiatives-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
