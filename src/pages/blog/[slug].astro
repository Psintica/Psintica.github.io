---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Helper to format Date
function formatDate(date) {
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title={`${entry.data.title} | Psintica`} activePage="Blog" description={entry.data.description}>
  <section class="section-padding" style="padding-bottom: 6rem;">
    <div class="container" style="max-width: 800px;">
      <!-- Back Link -->
      <a href="/blog/" class="back-link" style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; margin-bottom: 3rem; color: var(--color-text-muted);">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="5" y1="12" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Blog
      </a>

      <!-- Header Info -->
      <header style="margin-bottom: 3rem; border-bottom: 1px solid var(--color-border); padding-bottom: 2.5rem;">
        <div style="display: flex; gap: 0.75rem; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; font-size: 0.95rem; color: var(--color-text-muted);">
          <span style="color: var(--color-primary); font-weight: 600;">{formatDate(entry.data.pubDate)}</span>
          <span>•</span>
          <span>By <strong>{entry.data.author}</strong></span>
        </div>

        <h1 style="font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.25; margin-bottom: 1.5rem;">
          {entry.data.title}
        </h1>

        <!-- Tags -->
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          {entry.data.tags.map(tag => (
            <span style="font-size: 0.8rem; color: var(--color-primary); background: rgba(var(--color-primary-rgb), 0.05); border: 1px solid rgba(var(--color-primary-rgb), 0.1); padding: 0.25rem 0.75rem; border-radius: 50px;">
              {tag}
            </span>
          ))}
        </div>
      </header>

      <!-- Post Body -->
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .back-link:hover {
    color: var(--color-primary) !important;
  }
</style>
