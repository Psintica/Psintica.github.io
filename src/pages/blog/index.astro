---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => {
  // Filter out drafts in production builds
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort posts by date (newest first)
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Helper to format Date to readable string
function formatDate(date) {
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title="Blog | Psintica Research Lab" activePage="Blog">
  <!-- Page Header -->
  <section class="section-padding animate-fade-in" style="padding-bottom: 2rem;">
    <div class="container">
      <div class="badge" style="margin-bottom: 1rem;">Lab News & Insights</div>
      <h1>The Psintica Blog</h1>
      <p style="color: var(--color-text-secondary); font-size: 1.15rem; margin-top: 1rem; max-width: 700px;">
        Follow our journey at the intersection of AI and Science. We publish research updates, technical tutorials, lab announcements, and mentorship insights.
      </p>
    </div>
  </section>

  <!-- Blog Posts Listing -->
  <section class="section-padding" style="padding-top: 2rem; padding-bottom: 6rem;">
    <div class="container" style="max-width: 900px;">
      {sortedPosts.length === 0 ? (
        <div class="glass-card" style="text-align: center; padding: 4rem 2rem;">
          <p style="color: var(--color-text-muted); font-size: 1.1rem;">No blog posts published yet. Stay tuned!</p>
        </div>
      ) : (
        <div class="posts-list">
          {sortedPosts.map(post => (
            <article class="glass-card post-card">
              <!-- Header Meta Info -->
              <div class="post-meta">
                <span class="pub-date">{formatDate(post.data.pubDate)}</span>
                <span class="divider">•</span>
                <span class="author">By {post.data.author}</span>
              </div>

              <!-- Title & Excerpt -->
              <h2>
                <a href={`/blog/${post.id}/`} class="post-title-link">
                  {post.data.title}
                </a>
              </h2>
              
              <p class="description">
                {post.data.description}
              </p>

              <!-- Footer row: tags & read link -->
              <div class="card-footer">
                <div class="tags-list">
                  {post.data.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                
                <a href={`/blog/${post.id}/`} class="read-more-link">
                  Read Article &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    padding: 2.5rem;
    border-left: 3px solid var(--color-border);
  }

  .post-card:hover {
    border-left-color: var(--color-primary);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .pub-date {
    color: var(--color-primary);
    font-weight: 600;
  }

  .post-card h2 {
    font-size: clamp(1.5rem, 3.5vw, 1.85rem);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .post-title-link {
    color: var(--color-text-primary);
  }

  .post-title-link:hover {
    color: var(--color-primary);
    text-shadow: none;
  }

  .description {
    color: var(--color-text-secondary);
    font-size: 1.025rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .tags-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.01);
  }

  .read-more-link {
    font-size: 0.95rem;
    font-weight: 600;
    transition: var(--transition-snappy);
  }

  .post-card:hover .read-more-link {
    transform: translateX(4px);
    color: var(--color-text-primary);
  }
</style>
