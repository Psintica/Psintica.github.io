---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Join Undergrad Lab | Psintica Research Lab" activePage="Undergrad Lab">
  <!-- Page Header -->
  <section class="section-padding animate-fade-in" style="padding-bottom: 2rem;">
    <div class="container" style="text-align: center; max-width: 800px;">
      <div class="badge" style="margin-bottom: 1rem;">Accelerator Program</div>
      <h1>Undergraduate Research Lab</h1>
      <p style="color: var(--color-text-secondary); font-size: 1.2rem; margin-top: 1rem; line-height: 1.6;">
        We bridge the gap between classroom theory and active scientific breakthroughs. Psintica is designed to help undergraduate students transition into active researchers.
      </p>
    </div>
  </section>

  <!-- The Mentorship Model -->
  <section class="section-padding" style="padding-top: 2rem; padding-bottom: 4rem;">
    <div class="container">
      <div style="text-align: center; max-width: 600px; margin: 0 auto 4rem;">
        <h2>The Research Journey</h2>
        <p style="color: var(--color-text-muted); margin-top: 0.75rem;">
          How we take you from a curious student to an active contributor to scientific literature.
        </p>
      </div>

      <div class="timeline-grid">
        <div class="glass-card timeline-step">
          <div class="step-num">01</div>
          <h3>Foundations & Cohorts</h3>
          <p style="color: var(--color-text-secondary); margin-top: 1rem; font-size: 0.95rem;">
            Start with structured learning resources to build the foundational skills. Join the discord server to connect with peers and find your research cohort.
        </div>

        <div class="glass-card timeline-step">
          <div class="step-num">02</div>
          <h3>Active Project Mentorship</h3>
          <p style="color: var(--color-text-secondary); margin-top: 1rem; font-size: 0.95rem;">
            Work directly under the guidance of a research lead. Write code, design pipelines, analyze results, and join weekly lab syncs to discuss progress.
          </p>
        </div>

        <div class="glass-card timeline-step">
          <div class="step-num">03</div>
          <h3>Preprints & Open Science</h3>
          <p style="color: var(--color-text-secondary); margin-top: 1rem; font-size: 0.95rem;">
            Write up technical reports, prepare preprints, open-source your code repositories, and contribute to the broader scientific community.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Psintica Section -->
  <section class="section-padding" style="background: rgba(10, 15, 30, 0.4); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding-bottom: 5rem;">
    <div class="container">
      <div class="why-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
        <div>
          <img src="/images/illustrations/undraw_learning_re_32qv.svg" alt="Mentorship Illustration" style="width: 100%; max-width: 420px; height: auto;" />
        </div>
        <div>
          <div class="badge badge-secondary" style="margin-bottom: 1rem;">Why Join Us?</div>
          <h2 style="margin-bottom: 1.5rem;">A Different Kind of Lab</h2>
          
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 1.5rem;">
            <li style="display: flex; gap: 1rem; align-items: flex-start;">
              <div style="color: var(--color-primary); margin-top: 0.25rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <strong style="color: var(--color-text-primary); display: block; margin-bottom: 0.25rem;">Zero Gatekeeping</strong>
                <span style="font-size: 0.95rem; color: var(--color-text-secondary);">We value curiosity and commitment over prior publications. If you are willing to learn, you are welcome.</span>
              </div>
            </li>
            <li style="display: flex; gap: 1rem; align-items: flex-start;">
              <div style="color: var(--color-primary); margin-top: 0.25rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <strong style="color: var(--color-text-primary); display: block; margin-bottom: 0.25rem;">Practical AI Application</strong>
                <span style="font-size: 0.95rem; color: var(--color-text-secondary);">Gain hands-on experience applying machine learning models directly to actual scientific data (genomics, light-curves, etc.).</span>
              </div>
            </li>
            <li style="display: flex; gap: 1rem; align-items: flex-start;">
              <div style="color: var(--color-primary); margin-top: 0.25rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <strong style="color: var(--color-text-primary); display: block; margin-bottom: 0.25rem;">Peer Community</strong>
                <span style="font-size: 0.95rem; color: var(--color-text-secondary);">Work side-by-side with other undergraduate builders, sharing code and review feedback in a supportive peer network.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA section -->
  <section class="section-padding" style="padding-bottom: 7rem;">
    <div class="container" style="max-width: 800px; text-align: center;">
      <h2 style="margin-bottom: 1.5rem;">How to Get Started</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: 3rem; font-size: 1.1rem; line-height: 1.6;">
        We keep looking for new members! The easiest way to get involved is to join our Discord community, say hello in the general channel, and look out for active recruitment calls!
      </p>

      <div style="display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap;">
        <a href="https://discord.com/invite/Kjg3QYPTHj/" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="padding: 0.9rem 2.25rem;">
          Join Discord Community
        </a>
        <a href="/contact/" class="btn btn-secondary" style="padding: 0.9rem 2.25rem;">
          Contact Cohort Leads
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Timeline step */
  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .timeline-step {
    padding: 3rem 2rem 2.5rem;
    position: relative;
  }

  .step-num {
    position: absolute;
    top: 2rem;
    right: 2rem;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.03);
    line-height: 1;
    transition: var(--transition-smooth);
  }

  .timeline-step:hover .step-num {
    color: rgba(0, 242, 254, 0.1);
    transform: scale(1.1);
  }

  @media (max-width: 868px) {
    .timeline-grid {
      grid-template-columns: 1fr;
    }
    .why-grid {
      grid-template-columns: 1fr !important;
      gap: 3rem !important;
    }
    .why-grid div:first-child {
      display: flex;
      justify-content: center;
      order: 1;
    }
  }
</style>
