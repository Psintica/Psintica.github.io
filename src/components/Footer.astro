          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-links">
        <h5>Navigation</h5>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/initiatives/">Initiatives</a></li>
          <li><a href="/publications/">Publications</a></li>
          <li><a href="/team/">Team</a></li>
        </ul>
      </div>

      <!-- Engagement Links -->
      <div class="footer-links">
        <h5>Get Involved</h5>
        <ul>
          <li><a href="/join/">Undergrad Lab</a></li>
          <li><a href="/contact/">Contact Us</a></li>
          <li><a href="https://discord.com/invite/Kjg3QYPTHj/" target="_blank" rel="noopener noreferrer">Discord Server</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom footer -->
    <div class="footer-bottom">
      <div>
        &copy; {currentYear} Psintica. All rights reserved.
      </div>
      <div>
        Developed with ❤️ by <a href="https://amanasci.github.io/" target="_blank" rel="noopener noreferrer" style="color: var(--color-primary);">amanasci</a>
